# ── Emma AI · environment config ──────────────────────────────
# Copy this file once per environment and fill each value from that
# environment's Supabase project (Dashboard → Project Settings):
#
#   Local dev   →  .env              (values from `supabase start`)
#   Cloud test  →  .env.test         (Supabase project "emma-test")
#   Cloud prod  →  .env.production    (Supabase project "emma-prod")
#
# Select the active one with APP_ENV (see emma_core/config.py):
#   PowerShell:  $env:APP_ENV = "test"
#   bash:        export APP_ENV=test
#   (unset = development = .env)
#
# NEVER commit a filled-in copy - only .env.example is tracked.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: treat it like a root password.

# Settings → API → Project URL
SUPABASE_URL=http://127.0.0.1:54321

# Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=

# Settings → API → Project API keys → service_role (secret; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → URI
# (direct Postgres for migrations / seed / tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# development | test | production
APP_ENV=development
