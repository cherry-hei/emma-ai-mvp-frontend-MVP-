# ── Supabase (local dev via `supabase start`) ─────────────────
# Copy to .env and fill anon/service keys printed by `supabase start`.
# To switch to cloud later: change these four values only.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── App ───────────────────────────────────────────────────────
APP_ENV=development
