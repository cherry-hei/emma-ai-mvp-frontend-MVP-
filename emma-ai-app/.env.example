# ── Emma AI · environment config ──────────────────────────────
# Copy this file once per environment and fill each value from that
# environment's Supabase project (Dashboard → Project Settings):
#
#   Local dev   →  .env              (values from `supabase start`)
#   Cloud test  →  .env.test         (Supabase project "emma-test")
#   Cloud prod  →  .env.production    (Supabase project "emma-prod")
#
# Select the active one with APP_ENV (see emma_core/config.py):
#   PowerShell:  $env:APP_ENV = "test"
#   bash:        export APP_ENV=test
#   (unset = development = .env)
#
# NEVER commit a filled-in copy - only .env.example is tracked.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: treat it like a root password.

# Settings → API → Project URL
SUPABASE_URL=http://127.0.0.1:54321

# Settings → API → Project API keys → anon / public
SUPABASE_ANON_KEY=

# Settings → API → Project API keys → service_role (secret; bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string → URI
# (direct Postgres for migrations / seed / tests)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# development | test | production
APP_ENV=development

# ── Firebase Cloud Messaging · staff push notifications (spec SA.4b) ─────────
# Leave every one of these empty until the Firebase project is provisioned.
# `push.deliver()` then reports "fcm_not_configured" and leaves notifications
# queued, rather than marking them sent with nothing having left the building.
#
# Firebase console → Project settings → Service accounts → Generate new private
# key. Either paste the JSON itself (what a secret manager holds) or give a path
# to the downloaded file (what a developer has on disk). Treat it like a root
# password: it can send to every staff device in every facility.
FCM_SERVICE_ACCOUNT_JSON=

# Optional. The service account key already names its project; set this only to
# point a deploy at a different project than the key's own.
FCM_PROJECT_ID=

# Escape hatch for testing against a project whose key is not on this machine:
# `gcloud auth print-access-token`. Expires in one hour and is NOT refreshed,
# so never set it on a deploy - use FCM_SERVICE_ACCOUNT_JSON there.
FCM_ACCESS_TOKEN=
