    {"id": "decision_bundle", "owner": "backend_transaction", "atomic": ["request_CAS", "approved_unavailability_or_pins", "accounting", "immutable_audit", "outbox_intents"], "currently_implemented": false},
    {"id": "publish", "owner": "authorised_publish_role_then_backend_transaction", "hard_omit": false, "specific_soft_acknowledgements": true},
    {"id": "sync", "owner": "backend_outbox_and_staff_reads", "must_use_committed_receipts": true},
    {"id": "HR_record", "owner": "staff_supervisor_HR", "separate_external_authorisation": true, "currently_integrated": false},
    {"id": "history_forecast_QA", "owner": "deterministic_analytics_and_grounded_AI", "may_infer_new_hard_rule": false, "may_reduce_staff_automatically": false}
  ],
  "hard_invariants": ["law_and_qualification", "no_overlap_and_confirmed_rest", "approved_leave_or_locks", "confirmed_time_segment_coverage", "required_task_coverage", "approved_hard_budget", "NAAC_hash_D_plus_1"],
