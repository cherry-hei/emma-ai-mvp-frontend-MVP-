# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. It holds names and comments, never values - and the
# NEXT_PUBLIC_FIREBASE_* block is the only record of what the staff PWA needs
# wired up before push works (spec SA.4b).
!.env.example

# local dev credentials (never commit)
DEV_LOGINS.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# IDE
.idea/
.vscode/

# scratch dirs written by local tooling (a Postgres datadir once landed here)
.codex-temp/

# Python (backend has its own emma-ai-app/.gitignore too)
__pycache__/
*.pyc
.pytest_cache/
# docs/ holds the homes' own source workbooks - real rosters, with staff names in
# them. Those stay out of the repository. The written records beside them do not:
# committed code points at docs/naac/README.md for the provenance of the shift
# dictionary, and a code comment referencing a file nobody else has is worse than
# no comment.
#
# Exclude the contents, then re-include by name. Negating a path inside an
# excluded *directory* does not work - git never descends into it - so the
# directory itself has to stay listable.
/docs/*
!/docs/naac/
/docs/naac/*
!/docs/naac/*.md
!/docs/ZH_REVIEW.md
!/docs/ZH_REVIEW.csv
