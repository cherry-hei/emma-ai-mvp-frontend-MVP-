# Single origin on $PORT: static frontend + reverse-proxy to the Reflex backend.
# App Runner sends public HTTPS traffic to this port (default 8080).
:{$PORT:8080}

encode gzip zstd

# Backend (Reflex) routes: websocket events, health ping, and file uploads.
# reverse_proxy handles the websocket upgrade for /_event automatically.
@backend path /_event /_event/* /ping /_upload /_upload/*
handle @backend {
	reverse_proxy localhost:{$BACKEND_PORT:8000}
}

# Static frontend. Reflex 0.9 (React Router + Vite) exports to .web/build/client:
# prerendered pages (index.html, roster.html) + a SPA shell for client-side routes.
handle {
	root * /app/.web/build/client
	try_files {path} {path}.html {path}/ /__spa-fallback.html
	file_server
}
