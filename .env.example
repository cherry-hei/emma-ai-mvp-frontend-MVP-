# Emma AI · Next.js frontend environment template.
# Copy to .env.local and fill in. Never commit a filled-in copy.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are therefore
# public by definition. Nothing secret belongs here - the FCM sending credential
# is a service account key and lives on the API side (emma-ai-app/.env).

# The FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Firebase Cloud Messaging · staff PWA push (spec SA.4b) ───────────────────
# Leave empty until the Firebase project is provisioned. With any one of them
# missing, `enablePush()` reports 'not_configured' and the staff app never asks
# for a notification permission it could not honour - a permission the user
# blocks cannot be re-requested from the page.
#
# All four come from: Firebase console → Project settings → General → Your apps
# → Web app → SDK setup and configuration.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase console → Project settings → Cloud Messaging → Web configuration →
# Web Push certificates → "Key pair". Web push tokens cannot be minted without
# it, so push stays off if this alone is missing.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
